# Application Environment (development, production, test)
NODE_ENV=development

# Server Port
PORT=3000

# SQLite Persistent Datastore Path (use :memory: for in-memory testing)
DATABASE_PATH=./data/vehicles.sqlite

# Logging Level (fatal, error, warn, info, debug, trace, silent)
LOG_LEVEL=info

# External NHTSA Public API Base URL
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles

# Ingestion Concurrency (number of parallel HTTP requests for vehicle types)
INGESTION_CONCURRENCY=10

# Default Limit of Makes to Ingest (set 0 for all 12,000+ makes)
INGESTION_DEFAULT_LIMIT=50

# Synchronize / Ingest Data on Application Startup (true / false)
SYNC_ON_STARTUP=false

# External API HTTP Request Timeout (in milliseconds)
EXTERNAL_API_TIMEOUT_MS=15000

# External API Maximum Retries on Failure
EXTERNAL_API_MAX_RETRIES=3

# NestJS Observe Telemetry (Optional)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
